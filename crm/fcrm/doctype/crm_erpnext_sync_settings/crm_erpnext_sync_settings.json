  },
  {
   "fieldname": "automatic",
   "label": "Automatic",
   "fieldtype": "Check",
   "default": "0",
   "description": "Process up to 50 leads each scheduler cycle. Requires scheduler and workers."
  },
  {
   "fieldname": "status_map",
   "label": "Status Map",
   "fieldtype": "Code",
   "options": "JSON",
   "default": "{}"
  },
  {
   "fieldname": "user_map",
   "label": "User Map",
   "fieldtype": "Code",
   "options": "JSON",
   "default": "{}"
  },
  {
   "fieldname": "cursor",
   "label": "Cursor",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "last_run",
   "label": "Last Run",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "sync_opportunities",
   "label": "Sync Opportunities",
   "fieldtype": "Check",
   "default": "0",
